{
  "name": "Catalogo",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "producto",
        "presentacion",
        "variedad",
        "calibre",
        "calidad",
        "ubicacion",
        "estado",
        "tipo_movimiento"
      ]
    },
    "nombre": { "type": "string", "description": "Nombre visible para selección" },
    "codigo": { "type": "string", "description": "Código alfanumérico en mayúsculas usado en el código del tambor" },
    "activo": { "type": "boolean", "default": true },
    "orden": { "type": "number", "default": 1 },
    "created_date": { "type": "string", "format": "date-time" }
  },
  "required": [
    "tipo",
    "nombre",
    "codigo",
    "activo",
    "orden"
  ]
}
