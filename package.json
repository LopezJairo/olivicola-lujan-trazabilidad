{
  "name": "olivicola-lujan-trazabilidad",
  "version": "1.0.1",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "node server/index.js",
    "server:host": "PORT=4000 HOST=0.0.0.0 node server/index.js",
    "electron:start": "electron electron/main.cjs",
    "electron:dev": "ELECTRON_START_URL=http://localhost:5173 electron electron/main.cjs",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && node scripts/build-win.cjs",
    "electron:build:mac": "vite build && node scripts/build-mac.cjs",
    "electron:pack": "electron-builder --dir",
    "portal:dev": "vite portal --config portal/vite.config.js",
    "portal:build": "vite build --config portal/vite.config.js",
    "portal:preview": "vite preview --config portal/vite.config.js"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.59.16",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "jsbarcode": "^3.11.6",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "vitest": "^2.1.3"
  },
  "build": {
    "appId": "com.olivicolalujan.trazabilidad",
    "productName": "Olivicola Lujan Trazabilidad",
    "afterPack": "./scripts/afterPack.cjs",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.icns",
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
